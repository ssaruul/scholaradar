<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Scholaradar</title>
<link rel="alternate" type="application/rss+xml" title="Scholaradar feed" href="feed.xml">
<style>
  :root { --bg: #ffffff; --fg: #1a1a1a; --muted: #6b6b6b; --line: #e3e3e3; --card: #f7f7f7; --yes: #1b7f3b; --no: #a12d2d; --unclear: #946200; --accent: #2456b5; --saved: #b8860b; }
  @media (prefers-color-scheme: dark) { :root { --bg: #121212; --fg: #ececec; --muted: #9a9a9a; --line: #2a2a2a; --card: #1c1c1c; --yes: #5fcb7f; --no: #e07373; --unclear: #e0b35a; --accent: #7aa2ff; --saved: #e6c04c; } }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 16px; font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--fg); }
  header { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: baseline; margin-bottom: 10px; }
  h1 { font-size: 22px; margin: 0; }
  .meta { color: var(--muted); font-size: 13px; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; margin-bottom: 12px; }
  .links a, .links button { color: var(--accent); background: none; border: 0; padding: 0; font: inherit; cursor: pointer; text-decoration: none; }
  .links a:hover, .links button:hover { text-decoration: underline; }
  .filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin-bottom: 12px; }
  .filters label { display: flex; flex-direction: column; font-size: 12px; color: var(--muted); gap: 3px; }
  .filters input, .filters select { font: inherit; padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--fg); }
  .count { margin: 0 0 10px; color: var(--muted); font-size: 13px; }
  .card { border: 1px solid var(--line); background: var(--card); border-radius: 10px; padding: 12px 14px; margin-bottom: 10px; }
  .card.saved { border-color: var(--saved); }
  .card h2 { font-size: 16px; margin: 0 0 4px; }
  .card h2 a { color: var(--accent); text-decoration: none; }
  .card h2 a:hover { text-decoration: underline; }
  .row { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; color: var(--muted); margin-bottom: 6px; }
  .badge { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; border: 1px solid currentColor; }
  .yes { color: var(--yes); } .no { color: var(--no); } .unclear { color: var(--unclear); }
  .summary { margin: 4px 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 13px; margin-top: 6px; }
  .actions button, .actions a { color: var(--accent); background: none; border: 0; padding: 0; font: inherit; cursor: pointer; text-decoration: none; }
  .actions button:hover, .actions a:hover { text-decoration: underline; }
  details { font-size: 13px; color: var(--muted); }
  details summary { cursor: pointer; }
  blockquote { margin: 6px 0 0; padding-left: 10px; border-left: 3px solid var(--line); white-space: pre-wrap; }
  .deadline-soon { color: var(--no); font-weight: 600; }
  .empty { padding: 30px; text-align: center; color: var(--muted); }
</style>
</head>
<body>
<header>
  <h1>Scholaradar</h1>
  <span class="meta" data-i18n="meta"></span>
</header>
<div class="links">
  <button id="lang" type="button"></button>
  <a href="deadlines.ics" data-i18n="calendar"></a>
  <a href="feed.xml" data-i18n="feed"></a>
  <a href="opportunities.csv" data-i18n="csv"></a>
  <a href="{{ repo_url }}" target="_blank" rel="noopener" data-i18n="about"></a>
</div>
<div class="filters">
  <label><span data-i18n="search"></span><input id="q" type="search"></label>
  <label><span data-i18n="eligibility"></span><select id="elig"><option value="yes,unclear" data-i18n="eligOrUnclear"></option><option value="yes" data-i18n="eligOnly"></option><option value="yes,no,unclear" data-i18n="all"></option></select></label>
  <label><span data-i18n="level"></span><select id="level"></select></label>
  <label><span data-i18n="host"></span><select id="country"><option value="" data-i18n="any"></option></select></label>
  <label><span data-i18n="deadline"></span><select id="deadline"><option value="future" data-i18n="upcoming"></option><option value="30" data-i18n="d30"></option><option value="90" data-i18n="d90"></option><option value="all" data-i18n="incPast"></option></select></label>
  <label><span data-i18n="show"></span><select id="scope"><option value="active" data-i18n="scopeActive"></option><option value="saved" data-i18n="scopeSaved"></option><option value="hidden" data-i18n="scopeHidden"></option></select></label>
  <label><span data-i18n="sort"></span><select id="sort"><option value="deadline" data-i18n="byDeadline"></option><option value="new" data-i18n="byNew"></option></select></label>
</div>
<p class="count" id="count"></p>
<div id="list"></div>
<script id="data" type="application/json">{{ data_json | safe }}</script>
<script>
(function () {
  const rows = JSON.parse(document.getElementById('data').textContent);
  const today = new Date().toISOString().slice(0, 10);
  const target = {{ target_name | tojson }};
  const repo = {{ repo_url | tojson }};
  const generated = {{ generated | tojson }};
  const I18N = {
    en: { meta: `Eligibility judged for citizens of ${target} · ${rows.length} opportunities · updated ${generated}`, lang: 'Монгол', calendar: 'Subscribe to deadlines (calendar)', feed: 'RSS feed', csv: 'Download CSV', about: 'About / source code',
      search: 'Search', eligibility: 'Eligibility', eligOrUnclear: 'Eligible or unclear', eligOnly: 'Eligible only', all: 'All', level: 'Level', any: 'Any', host: 'Host country', deadline: 'Deadline', upcoming: 'Upcoming or none', d30: 'Within 30 days', d90: 'Within 90 days', incPast: 'Include past', show: 'Show', scopeActive: 'Not hidden', scopeSaved: 'Saved only', scopeHidden: 'Hidden only', sort: 'Sort', byDeadline: 'Deadline', byNew: 'Newest first',
      shown: (a, b) => `${a} of ${b} shown`, eligible: 'Eligible', notEligible: 'Not eligible', unclear: 'Unclear', unverified: ' (unverified)', deadlineLabel: 'Deadline', days: d => `${d} days`, noDeadline: 'No deadline stated', evidence: 'Evidence, source', noEvidence: 'No explicit statement found on the page.', fields: 'Fields', source: 'Source', firstSeen: 'first seen', alsoOn: 'Also found on', save: 'Save', unsave: 'Saved', hide: 'Hide', unhide: 'Unhide', addCal: 'Add to Google Calendar', wrong: 'Report a mistake', empty: 'Nothing matches these filters.',
      levels: { bachelor: 'bachelor', master: 'master', phd: 'PhD', postdoc: 'postdoc', research: 'research', exchange: 'exchange', short_course: 'short course', language: 'language', other: 'other' },
      funding: { full: 'fully funded', partial: 'partial', tuition_only: 'tuition only', stipend_only: 'stipend only', unknown: 'funding unknown' } },
    mn: { meta: `Монгол Улсын иргэдэд хамаарах эсэхийг шалгасан · ${rows.length} тэтгэлэг · шинэчилсэн ${generated}`, lang: 'English', calendar: 'Хугацааны календарьт бүртгүүлэх', feed: 'RSS', csv: 'CSV татах', about: 'Тухай / эх код',
      search: 'Хайх', eligibility: 'Хамаарах эсэх', eligOrUnclear: 'Хамаарах эсвэл тодорхойгүй', eligOnly: 'Зөвхөн хамаарах', all: 'Бүгд', level: 'Түвшин', any: 'Бүгд', host: 'Суралцах улс', deadline: 'Хугацаа', upcoming: 'Удахгүй болон заагаагүй', d30: '30 хоногийн дотор', d90: '90 хоногийн дотор', incPast: 'Өнгөрснийг оруулах', show: 'Харуулах', scopeActive: 'Нуугаагүй', scopeSaved: 'Зөвхөн хадгалсан', scopeHidden: 'Зөвхөн нуусан', sort: 'Эрэмбэ', byDeadline: 'Хугацаагаар', byNew: 'Шинээр нэмэгдсэн',
      shown: (a, b) => `${b}-с ${a} харуулж байна`, eligible: 'Хамаарна', notEligible: 'Хамаарахгүй', unclear: 'Тодорхойгүй', unverified: ' (баталгаажаагүй)', deadlineLabel: 'Хугацаа', days: d => `${d} хоног`, noDeadline: 'Хугацаа заагаагүй', evidence: 'Нотолгоо, эх сурвалж', noEvidence: 'Хуудсан дээр тодорхой өгүүлбэр олдсонгүй.', fields: 'Чиглэл', source: 'Эх сурвалж', firstSeen: 'анх олдсон', alsoOn: 'Мөн эндээс олдсон', save: 'Хадгалах', unsave: 'Хадгалсан', hide: 'Нуух', unhide: 'Буцаах', addCal: 'Google Calendar-т нэмэх', wrong: 'Алдаа мэдэгдэх', empty: 'Энэ шүүлтүүрт тохирох зүйл алга.',
      levels: { bachelor: 'бакалавр', master: 'магистр', phd: 'доктор', postdoc: 'постдок', research: 'судалгаа', exchange: 'солилцоо', short_course: 'богино хугацааны', language: 'хэлний', other: 'бусад' },
      funding: { full: 'бүрэн санхүүжилт', partial: 'хэсэгчилсэн', tuition_only: 'зөвхөн сургалтын төлбөр', stipend_only: 'зөвхөн тэтгэмж', unknown: 'санхүүжилт тодорхойгүй' } },
  };
  const byId = id => document.getElementById(id);
  const store = (key, fallback) => { try { return JSON.parse(localStorage.getItem(key)) ?? fallback; } catch (e) { return fallback; } };
  const keep = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) {} };
  let lang = store('scholaradar.lang', navigator.language && navigator.language.startsWith('mn') ? 'mn' : 'en');
  const saved = new Set(store('scholaradar.saved', []));
  const hidden = new Set(store('scholaradar.hidden', []));
  const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const daysUntil = d => Math.round((new Date(d) - new Date(today)) / 86400000);
  const t = () => I18N[lang];
  const levels = new Set(), countries = new Set();
  rows.forEach(r => { r.degree_levels.forEach(l => levels.add(l)); if (r.host_country) countries.add(r.host_country); });
  [...countries].sort().forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; byId('country').appendChild(o); });
  const levelSelect = byId('level');
  function applyLanguage() {
    document.documentElement.lang = lang;
    document.querySelectorAll('[data-i18n]').forEach(el => { const v = t()[el.dataset.i18n]; if (typeof v === 'string') el.textContent = v; });
    byId('lang').textContent = t().lang;
    const current = levelSelect.value;
    levelSelect.innerHTML = `<option value="">${esc(t().any)}</option>` + [...levels].sort().map(l => `<option value="${esc(l)}">${esc(t().levels[l] || l)}</option>`).join('');
    levelSelect.value = current;
  }
  function gcal(r) {
    const d = r.deadline.replace(/-/g, '');
    const next = new Date(r.deadline); next.setDate(next.getDate() + 1);
    const e = next.toISOString().slice(0, 10).replace(/-/g, '');
    const params = new URLSearchParams({ action: 'TEMPLATE', text: `Deadline: ${r.title.slice(0, 80)}`, dates: `${d}/${e}`, details: `${r.eligibility_summary || ''}\n${r.apply_url || r.page_url}` });
    return `https://calendar.google.com/calendar/render?${params.toString()}`;
  }
  function issueUrl(r) {
    const body = `Page: ${r.page_url}\nCurrent verdict: ${r.target_eligible}\nCurrent deadline: ${r.deadline || 'none'}\n\nWhat is wrong (eligibility, deadline, duplicate, not a scholarship)?\n\n`;
    const params = new URLSearchParams({ title: `Correction: ${r.title.slice(0, 70)}`, body, labels: 'correction' });
    return `${repo}/issues/new?${params.toString()}`;
  }
  function render() {
    const q = byId('q').value.trim().toLowerCase();
    const elig = byId('elig').value.split(',');
    const level = levelSelect.value, country = byId('country').value, dl = byId('deadline').value, sort = byId('sort').value, scope = byId('scope').value;
    let out = rows.filter(r => elig.includes(r.target_eligible)
      && (scope === 'hidden' ? hidden.has(r.id) : scope === 'saved' ? saved.has(r.id) : !hidden.has(r.id))
      && (!level || r.degree_levels.includes(level))
      && (!country || r.host_country === country)
      && (dl === 'all' || !r.deadline || (r.deadline >= today && (dl === 'future' || daysUntil(r.deadline) <= Number(dl))))
      && (!q || [r.title, r.provider, r.host_country, r.eligibility_summary, ...r.fields_of_study].join(' ').toLowerCase().includes(q)));
    if (sort === 'new') out.sort((a, b) => b.first_seen.localeCompare(a.first_seen));
    else out.sort((a, b) => (a.deadline || '9999').localeCompare(b.deadline || '9999'));
    byId('count').textContent = t().shown(out.length, rows.length);
    byId('list').innerHTML = out.length ? out.map(card).join('') : `<p class="empty">${esc(t().empty)}</p>`;
  }
  function card(r) {
    const s = t();
    const soon = r.deadline && r.deadline >= today && daysUntil(r.deadline) <= 14;
    const deadline = r.deadline ? `<span class="${soon ? 'deadline-soon' : ''}">${esc(s.deadlineLabel)} ${esc(r.deadline)}${soon ? ' (' + s.days(daysUntil(r.deadline)) + ')' : ''}</span>` : `<span>${esc(s.noDeadline)}</span>`;
    const verdict = r.target_eligible === 'yes' ? s.eligible : r.target_eligible === 'no' ? s.notEligible : s.unclear;
    const isSaved = saved.has(r.id), isHidden = hidden.has(r.id);
    return `<article class="card ${isSaved ? 'saved' : ''}" data-id="${r.id}">
      <h2><a href="${esc(r.apply_url || r.page_url)}" target="_blank" rel="noopener">${esc(r.title)}</a></h2>
      <div class="row">
        <span class="badge ${r.target_eligible}">${esc(verdict)}${r.evidence_verified ? '' : esc(s.unverified)}</span>
        ${r.provider ? `<span>${esc(r.provider)}</span>` : ''}
        ${r.host_country ? `<span>${esc(r.host_country)}</span>` : ''}
        ${r.degree_levels.length ? `<span>${esc(r.degree_levels.map(l => s.levels[l] || l).join(', '))}</span>` : ''}
        <span>${esc(s.funding[r.funding_type] || r.funding_type)}</span>
        ${deadline}
      </div>
      <p class="summary">${esc(r.eligibility_summary)}</p>
      <div class="actions">
        <button type="button" data-act="save">${isSaved ? '★ ' + esc(s.unsave) : '☆ ' + esc(s.save)}</button>
        <button type="button" data-act="hide">${isHidden ? esc(s.unhide) : esc(s.hide)}</button>
        ${r.deadline && r.deadline >= today ? `<a href="${gcal(r)}" target="_blank" rel="noopener">${esc(s.addCal)}</a>` : ''}
        <a href="${issueUrl(r)}" target="_blank" rel="noopener">${esc(s.wrong)}</a>
      </div>
      <details><summary>${esc(s.evidence)}</summary>
        ${r.evidence_quote ? `<blockquote>${esc(r.evidence_quote)}</blockquote>` : `<p>${esc(s.noEvidence)}</p>`}
        <p>${r.fields_of_study.length ? esc(s.fields) + ': ' + esc(r.fields_of_study.join(', ')) + ' &middot; ' : ''}${esc(s.source)}: <a href="${esc(r.page_url)}" target="_blank" rel="noopener">${esc(r.page_url)}</a> &middot; ${esc(s.firstSeen)} ${esc(r.first_seen.slice(0, 10))}</p>
        ${(r.also_on || []).length ? `<p>${esc(s.alsoOn)}: ${r.also_on.map(o => `<a href="${esc(o.url)}" target="_blank" rel="noopener">${esc(o.title.slice(0, 60))}</a>`).join(' &middot; ')}</p>` : ''}
      </details>
    </article>`;
  }
  byId('list').addEventListener('click', e => {
    const button = e.target.closest('button[data-act]');
    if (!button) return;
    const id = Number(button.closest('.card').dataset.id);
    const set = button.dataset.act === 'save' ? saved : hidden;
    set.has(id) ? set.delete(id) : set.add(id);
    keep('scholaradar.saved', [...saved]); keep('scholaradar.hidden', [...hidden]);
    render();
  });
  byId('lang').addEventListener('click', () => { lang = lang === 'en' ? 'mn' : 'en'; keep('scholaradar.lang', lang); applyLanguage(); render(); });
  ['q', 'elig', 'level', 'country', 'deadline', 'scope', 'sort'].forEach(id => byId(id).addEventListener('input', render));
  applyLanguage();
  render();
})();
</script>
</body>
</html>
