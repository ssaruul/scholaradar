<!doctype html>
<html>
<body style="font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; font-size: 15px; color: #1a1a1a; max-width: 720px; margin: 0 auto; padding: 16px;">
<h1 style="font-size: 20px; margin: 0 0 4px;">Scholaradar, {{ today }}</h1>
<p style="color: #6b6b6b; margin: 0 0 18px;">{{ rows | length }} opportunities for citizens of {{ target_name }}, sorted by deadline.</p>
{% for r in rows %}
<div style="border: 1px solid #e3e3e3; border-radius: 8px; padding: 12px 14px; margin-bottom: 10px;">
  <div style="font-size: 16px; font-weight: 600;"><a href="{{ r.apply_url or r.page_url }}" style="color: #2456b5; text-decoration: none;">{{ r.title }}</a></div>
  <div style="color: #6b6b6b; font-size: 13px; margin: 4px 0;">
    {% if r.target_eligible == 'yes' %}<strong style="color: #1b7f3b;">Eligible</strong>{% elif r.target_eligible == 'no' %}<strong style="color: #a12d2d;">Not eligible</strong>{% else %}<strong style="color: #946200;">Unclear</strong>{% endif %}
    {% if not r.evidence_verified %}(unverified){% endif %}
    {% if r.provider %}&middot; {{ r.provider }}{% endif %}
    {% if r.host_country %}&middot; {{ r.host_country }}{% endif %}
    {% if r.degree_levels %}&middot; {{ r.degree_levels | join(', ') }}{% endif %}
    &middot; {{ r.funding_type }}
    &middot; {% if r.deadline %}Deadline {{ r.deadline }}{% else %}No deadline stated{% endif %}
  </div>
  <div>{{ r.eligibility_summary }}</div>
  {% if r.evidence_quote %}<blockquote style="margin: 6px 0 0; padding-left: 10px; border-left: 3px solid #e3e3e3; color: #6b6b6b; font-size: 13px;">{{ r.evidence_quote }}</blockquote>{% endif %}
</div>
{% else %}
<p>No new opportunities since the last run.</p>
{% endfor %}
</body>
</html>
