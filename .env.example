MODELS_DIR=/home/you/models/gguf
# a glob is allowed, e.g. /media/you/HDD*/models/gguf, when the mount name changes between boots
LLAMA_MODEL=gemma-4-26B-A4B-it-UD-Q4_K_M.gguf
LLAMA_MODE=docker
LLAMA_BIN=
LLAMA_CTX=65536
LLAMA_PARALLEL=4
LLAMA_KV_TYPE=q8_0
LLAMA_PORT=8089
NVIDIA_DISABLE_REQUIRE=0

SEARXNG_SECRET=generate-with-openssl-rand-hex-32

LLM_BASE_URL=http://localhost:8089/v1
LLM_MODEL=local
LLM_API_KEY=
SEARX_BASE_URL=http://localhost:8888

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password
DIGEST_FROM=you@gmail.com
DIGEST_TO=you@gmail.com

GIT_PUSH=false

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
TELEGRAM_BOT_TOKEN=
